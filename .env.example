# ==============================================================================
# HeatWatch AI — environment configuration example
# Copy to backend/.env (or the repository root) and fill in real values.
# NEVER commit real credentials.
# ==============================================================================

# --- Security (REQUIRED in production; dev defaults exist but must change) ---
SECRET_KEY=change-me-to-a-long-random-string
JWT_SECRET_KEY=change-me-to-another-long-random-string
JWT_ACCESS_TOKEN_HOURS=12

# --- Runtime ---
FLASK_ENV=development
PORT=5000

# --- Database ---------------------------------------------------------------
# MySQL is the documented production target (SRS 2.3.3). docker-compose.yml
# provisions MySQL 8 with these default credentials:
# DATABASE_URL=mysql+pymysql://heatwatch:heatwatch@localhost:3306/heatwatch?charset=utf8mb4
#
# When DATABASE_URL is not set, the app falls back to a local SQLite file
# (development convenience only; real file persistence, not MySQL).
# DATABASE_URL=mysql+pymysql://heatwatch:heatwatch@localhost:3306/heatwatch?charset=utf8mb4

# --- Data mode --------------------------------------------------------------
# auto  -> live weather provider when OPENWEATHER_API_KEY exists, otherwise
#          the clearly-labelled demonstration provider (default for dev)
# live  -> require real providers (startup/errors surface if unconfigured)
# demo  -> force demonstration providers for everything
DATA_MODE=auto

# --- Weather provider (FR-02) ------------------------------------------------
# Free API key from https://openweathermap.org/api — keep it server-side only.
OPENWEATHER_API_KEY=
OPENWEATHER_BASE_URL=https://api.openweathermap.org/data/2.5
WEATHER_TIMEOUT_SECONDS=10
API_MAX_RETRIES=3

# --- Social media provider (FR-03) -------------------------------------------
# auto|demo|reddit. "reddit" uses Reddit's public read-only search endpoint
# with a descriptive User-Agent. A licensed provider adapter can be added by
# implementing app/integrations/social/demo_provider.py::SocialProvider.
SOCIAL_PROVIDER=auto
REDDIT_USER_AGENT=HeatWatchAI/1.0 (student research project; contact: you@example.com)
SOCIAL_TIMEOUT_SECONDS=10

# --- Background collection ----------------------------------------------------
WEATHER_COLLECTION_MINUTES=30
SOCIAL_COLLECTION_MINUTES=60
WEATHER_FRESH_MINUTES=90

# --- Alerts (FR-06; also editable at runtime in the admin panel) ---------------
ALERT_HIGH_THRESHOLD=70
ALERT_MODERATE_THRESHOLD=40
ALERT_COOLDOWN_MINUTES=180
ALERTS_ENABLED=true

# --- Security controls ----------------------------------------------------------
AUTH_RATE_LIMIT=10
AUTH_RATE_LIMIT_WINDOW_MINUTES=15
MAX_JSON_BODY_BYTES=262144
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- Reports ----------------------------------------------------------------------
REPORT_OUTPUT_DIR=

# --- Presentation ---------------------------------------------------------------
DISPLAY_TIMEZONE=Asia/Kolkata

# --- Initial administrator bootstrap (create_admin.py) ---------------------------
ADMIN_USERNAME=
ADMIN_EMAIL=
ADMIN_PASSWORD=
